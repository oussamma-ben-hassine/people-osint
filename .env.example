APP_NAME=People OSINT
APP_ENV=production
APP_URL=https://people.oussamma.tn
PORT=8000

# Base de données PostgreSQL (pgvector)
POSTGRES_DB=people_db
POSTGRES_USER=people_user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://people_user:CHANGE_ME@people-postgres:5432/people_db
DATABASE_SYNC_URL=postgresql+psycopg2://people_user:CHANGE_ME@people-postgres:5432/people_db

# Cache & Broker Redis
REDIS_URL=redis://people-redis:6379/0

# SSO Central (OpenID Connect + PKCE)
OIDC_ISSUER=https://sso-a.oussamma.tn/
OIDC_CLIENT_ID=client_people_osint
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://people.oussamma.tn/auth/callback
OIDC_SCOPES=openid profile email

# Exigence 3.2 : Bootstrap SUPER_ADMIN initial (Sub stable et Issuer)
INITIAL_SUPERADMIN_ISSUER=https://sso-a.oussamma.tn
INITIAL_SUPERADMIN_SUB=

# Passerelle IA Centralisée LiteLLM
LITELLM_BASE_URL=https://ai.oussamma.tn/v1
LITELLM_API_KEY=
LITELLM_CHAT_MODEL=gemini/gemini-3.1-flash-lite-preview
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
LITELLM_TIMEOUT=45

# Moteur de recherche SearXNG
SEARXNG_BASE_URL=http://people-searxng:8080

# Connecteurs optionnels
GITHUB_TOKEN=
GITLAB_TOKEN=
HIBP_API_KEY=

# Clés de chiffrement et de session (AES-GCM & HMAC)
ENCRYPTION_KEY=
SESSION_SECRET=

# Politiques de sécurité et rétention
DEFAULT_ACCESS_POLICY=deny
AI_ENABLED=true
KNOWLEDGE_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7
